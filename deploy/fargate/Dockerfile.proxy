# The front door of the Fargate task:  nginx with this deployment's routes.
# Build context: this directory.
# The stable line, which is the one that receives fixes (1.27 was a mainline
# line, ended in 2025: its image had 12 critical findings in ECR's scan on
# 23 November 2026).  Each build also takes Alpine's current packages.
FROM public.ecr.aws/nginx/nginx:1.30-alpine
RUN apk upgrade --no-cache
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY site /usr/share/nginx/aiab

# Defaults for a deployment with no TLS in front of it.  One that is served
# over HTTPS sets PUBLIC_SCHEME=https and turns the cookie line into a comment.
ENV PUBLIC_SCHEME=http \
    HSTS_HEADER="" \
    TAP_BODY_MAX="60m" \
    PROXY_COOKIE_FLAGS="proxy_cookie_flags ~ nosecure samesite=lax;"
