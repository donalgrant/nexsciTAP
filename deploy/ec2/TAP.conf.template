[WEB]
    TAP_WORKDIR=/work
    TAP_WORKURL=/workspace
    HTTP_URL=__PUBLIC_URL__
    HTTP_PORT=80
    HTTP_HOSTS=__HTTP_HOSTS__
    CGI_PGM=TAP
    MAXREC_LIMIT=__MAXREC_LIMIT__
    CLIENT_HEADER=__CLIENT_HEADER__
    CLIENT_LIMIT=__CLIENT_LIMIT__
    ASYNC_LIMIT=__ASYNC_LIMIT__
    ASYNC_CLIENT_LIMIT=__ASYNC_CLIENT_LIMIT__
    UNLIMITED_CLIENTS=__UNLIMITED_CLIENTS__

[DBMS]
    DBMS=duckdb
    DB=/var/lib/tap/catalog.duckdb
    TAP_SCHEMA=tap_schema
    INIT_SQL_FILE=/opt/tap/s3_init.sql
    ALLOWED_DIRECTORIES=__CATALOG_PREFIX__
    ALLOWED_PATHS=/etc/ssl/certs/ca-certificates.crt
    QUERY_TIMEOUT=__QUERY_TIMEOUT__

[SPTIND]
    MODE=HPX
    LEVEL=14
    STORED_LEVEL=29
    XCOL=x
    YCOL=y
    ZCOL=z
    COLNAME=hpx29
    ENCODING=BASE10
